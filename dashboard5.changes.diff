+// The server checks the database for this user's saved signature/stamp in the record's project.
+// Returns a message ONLY when the server says nothing is saved. If the check itself fails
+// (network, session), it returns null: the server re-checks when signing, so we never wrongly claim "no stamp".
+async function flowCheckSigningReady({ recordId, tabKey, mode } = {}) {
+  try {
+    const q = new URLSearchParams({ mode: mode || 'decision' });
+    if (recordId && tabKey) { q.set('recordId', recordId); q.set('recordType', tabToTable(tabKey)); }
+    else q.set('projectId', localStorage.getItem('activeProjectId') || '');
+    const res = await authFetch(`${API}/signing-readiness?${q.toString()}`);
+    if (!res || !res.ok) return null;
+    const d = await res.json();
+    return d.ready ? null : (d.message || 'You have not set up a signature or stamp for this project.');
+  } catch (_) { return null; }
+}
